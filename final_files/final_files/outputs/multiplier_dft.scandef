       valid_out_reg ( IN SI ) ( OUT Q ) 
       y_reg[0] ( IN SI ) ( OUT Q ) 
       y_reg[1] ( IN SI ) ( OUT Q ) 
       y_reg[2] ( IN SI ) ( OUT Q ) 
       y_reg[3] ( IN SI ) ( OUT Q ) 
       y_reg[4] ( IN SI ) ( OUT Q ) 
       y_reg[5] ( IN SI ) ( OUT Q ) 
       y_reg[6] ( IN SI ) ( OUT Q ) 
       y_reg[7] ( IN SI ) ( OUT Q ) 
       y_reg[8] ( IN SI ) ( OUT Q ) 
       y_reg[9] ( IN SI ) ( OUT Q ) 
       y_reg[10] ( IN SI ) ( OUT Q ) 
       y_reg[11] ( IN SI ) ( OUT Q ) 
       y_reg[12] ( IN SI ) ( OUT Q ) 
       y_reg[13] ( IN SI ) ( OUT Q ) 
       y_reg[14] ( IN SI ) ( OUT Q ) 
       y_reg[15] ( IN SI ) ( OUT Q ) 
       y_reg[16] ( IN SI ) ( OUT Q ) 
       y_reg[17] ( IN SI ) ( OUT Q ) 
       y_reg[18] ( IN SI ) ( OUT Q ) 
       y_reg[19] ( IN SI ) ( OUT Q ) 
       y_reg[20] ( IN SI ) ( OUT Q ) 
       y_reg[21] ( IN SI ) ( OUT Q ) 
       y_reg[22] ( IN SI ) ( OUT Q ) 
       y_reg[23] ( IN SI ) ( OUT Q ) 
       y_reg[24] ( IN SI ) ( OUT Q ) 
       y_reg[25] ( IN SI ) ( OUT QN ) 
       y_reg[26] ( IN SI ) ( OUT QN ) 
       y_reg[27] ( IN SI ) ( OUT QN ) 
       y_reg[28] ( IN SI ) ( OUT QN ) 
       y_reg[29] ( IN SI ) ( OUT QN ) 
       y_reg[30] ( IN SI ) ( OUT QN ) 
       y_reg[31] ( IN SI ) ( OUT QN ) 
    + STOP PIN scan_out
;

END SCANCHAINS 
END DESIGN 
